  "suite_names": {
    "p01": {
      "baseline": [
        "supplied deterministic generator and synchronous oracle agree",
        "supplied fake worker exposes browser-like message lifecycle"
      ],
      "objective": [
        "validation and pre-abort avoid worker creation while send is pre-registered",
        "concurrent out-of-order results and monotonic progress correlate",
        "abort sends cancel once and ignores a late result",
        "worker errors reject all safely and later instances remain isolated",
        "disposal terminates, removes listeners, rejects pending, and is idempotent"
      ],
      "regression": [
        "worker source stays DOM-free and main UI owns presentation",
        "page has accessible controls and status output",
        "package is dependency-free and no fake main-thread offload exists"
      ]
    },
    "p02": {
      "baseline": [
        "supplied fake container publishes messages and controller changes",
        "supplied registration helper uses explicit script and scope"
      ],
      "objective": [
        "uncontrolled and non-target requests use explicit direct fallback",
        "controlled request posts after pending registration and correlates exact source/version",
        "unknown, malformed, duplicate, and safe failure messages remain isolated",
        "timeout falls back once and controller change rejects pending generation",
        "disposal rejects pending, removes listeners, and prevents later dispatch"
      ],
      "regression": [
        "service worker uses exact same-origin task path and scoped cache prefix",
        "page remains accessible and explicitly avoids offline completeness",
        "package is dependency-free and dispatcher uses no storage/global proxy"
      ]
    },
    "p03": {
      "baseline": [
        "supplied host and frame adapters expose listener and exact-target traces",
        "supplied architecture note compares a normal application first"
      ],
      "objective": [
        "descriptor validation, exact origin/source/version, and one listener fail closed",
        "timeout and disposal expose unavailable state and clean all instances",
        "readiness queues only latest state and sends exact target origin",
        "catalog intent loads authoritative state then targets details",
        "replacement generation rejects stale messages and requires new readiness"
      ],
      "regression": [
        "shell frames are labeled, sandboxed, and registered before navigation",
        "fragments target only shell and never address each other or shell history",
        "package is dependency-free and docs reject fake auth/framework completeness"
      ]
    },
    "rh": {
      "objective": [
        "every run closes servers and releases active-run state",
        "descriptor separates unit, integration, and HTTP boundaries",
        "isolated behavior contracts pass twice with stable names",
        "HTTP contracts include persisted follow-up and safe error behavior",
        "all supplied realistic mutations are killed by named contracts"
      ],
      "regression": [
        "package is dependency-free ESM with categorized commands",
        "application retains canonical safe error boundary",
        "documentation bounds mutation evidence and avoids completeness claims"
      ],
      "baseline": [
        "supplied checklist service validates, persists, and completes",
        "supplied HTTP adapter is independently constructible"
      ]
    }
  },
