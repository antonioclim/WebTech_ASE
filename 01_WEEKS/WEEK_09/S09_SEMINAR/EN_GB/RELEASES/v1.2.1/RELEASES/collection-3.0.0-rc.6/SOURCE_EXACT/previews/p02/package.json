{
  "name": "full-stack-notes-crud-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "vitest run --config client/vite.config.js",
    "test:baseline": "vitest run --config client/vite.config.js tests/baseline.test.js",
    "test:objective": "vitest run --config client/vite.config.js tests/objective.test.jsx",
    "test:regression": "vitest run --config client/vite.config.js tests/regression.test.jsx"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": "6.16.0",
    "@vitest/mocker": "4.1.11"
  }
}
