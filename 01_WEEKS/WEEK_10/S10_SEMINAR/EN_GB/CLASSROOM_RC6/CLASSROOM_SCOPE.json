  "projects": [
    {
      "id": "P01",
      "title": "Shared state: pure reducer",
      "editable_path": "CLASSROOM_RC6/student/p01.mjs",
      "completeScope": "Implement track/selected, session/toggled and saved/cleared while preserving unrelated state and input arrays. An unsupported action returns an explicit unsupported_action result for this classroom API. This deliberately differs from the full developer-facing exception contract and does not implement Context/hooks."
    },
    {
      "id": "P02",
      "title": "Notifications: latest refresh wins",
      "editable_path": "CLASSROOM_RC6/student/p02.mjs",
      "completeScope": "Accept only the matching latest successful refresh and recompute unread count from the authoritative array; retain old entities on failure/stale success. The input is explicit synthetic state. This is not Redux Toolkit execution, a thunk, normalized entity storage or an HTTP request."
    },
    {
      "id": "P03",
      "title": "Architecture: capability before cost",
      "editable_path": "CLASSROOM_RC6/student/p03.mjs",
      "completeScope": "Exclude candidates lacking any required capability before comparing declared nonnegative cost. Return the sole lowest-cost candidate, null for no eligible candidate or a tie. Costs are supplied exercise data, not measurements or universal library rankings."
    }
  ],
